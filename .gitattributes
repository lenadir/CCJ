# Let git normalise ordinary text, but keep the files Windows runs as CRLF. A .cmd with LF line
# endings can misbehave with labels and goto on some Windows versions.
* text=auto

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf

# Binary files are never touched.
*.exe binary
*.dll binary
*.png binary

# Never touch these, whatever their extension. They are compared byte for byte: Vox\ holds the
# reference script that the fidelity tests check the generator against, and packages\ is
# third party code. These lines come last so they override the rules above.
Vox/** -text
packages/** -text
