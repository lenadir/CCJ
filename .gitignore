.vs/

# dist/ holds the release build (CCJ.exe, CCJ-Setup.exe and what they need) and IS committed.
# Rebuild it with build-installer.cmd before committing, so it matches the source.
#
# packages/ (the extracted NuGet packages) is committed too, so a fresh clone builds offline.
#
# Vox/ is the local dev/test runtime root: generated .bat scripts and real-looking logs. It is
# not needed to build or run CCJ and is deliberately not pushed. ReferenceFidelityTests.cs skips
# itself (Assert.Ignore) when Vox\Backup_Folder1.bat is absent, so a fresh clone's test run is
# unaffected.
Vox/

# The original brief, kept out of the public repository.
prompt.txt
